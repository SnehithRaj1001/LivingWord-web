# LivingWord Environment Variables

# Supabase Auth & Database (replace with your Supabase Project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (for AI Summarization & Vector Embeddings)
GEMINI_API_KEY=your-gemini-api-key

# API.Bible Key (for Scripture Passages)
BIBLE_API_KEY=your-api-bible-key
